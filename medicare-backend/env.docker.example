# ============================================================
# MediCare Pro — Docker Environment Variables
# Copy this to .env.docker and fill in real values
# NEVER commit .env.docker to Git
# ============================================================

PORT=5000
NODE_ENV=development

# Database — use service name "db" as host (not localhost)
DB_HOST=db
DB_PORT=3306
DB_NAME=medicare_pro
DB_USER=medicare_user
DB_PASS=medicare_pass
DB_ROOT_PASSWORD=rootpassword

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# CORS
FRONTEND_URL=http://localhost:80
CORS_ORIGINS=http://localhost:80,http://localhost:3000
