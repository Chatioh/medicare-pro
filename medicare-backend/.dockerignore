# ============================================================
# MediCare Pro Backend — .dockerignore
# Excludes files from Docker build context (faster builds,
# smaller images, no secrets accidentally copied in)
# ============================================================

# Dependencies (installed fresh inside container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (injected at runtime, never baked into image)
.env
.env.*
!.env.example

# Test files (not needed in production image)
tests/
coverage/
*.test.js
jest.config.*

# Dev tools
.eslintrc*
.prettierrc*
.editorconfig
nodemon.json
*.log

# Version control
.git/
.gitignore
.gitattributes

# Documentation (not needed in image)
README.md
CHANGELOG.md
docs/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
